{
  "name": "superset-plugin-chart-stratum-heatmap",
  "version": "0.2.0",
  "description": "StratumHeatmap — Interactive ECharts Matrix Grid Chart Plugin for Apache Superset",
  "homepage": "https://github.com/FrancescoCastaldi/superset-plugin-chart-stratum-heatmap",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancescoCastaldi/superset-plugin-chart-stratum-heatmap.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build || node ./node_modules/typescript/lib/tsc.js --build || npx tsc --build",
    "clean": "rimraf dist",
    "test": "vitest run",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "install:plugin": "powershell -ExecutionPolicy Bypass -File ./install-plugin.ps1",
    "install:plugin:node": "node ./scripts/install.js"
  },
  "keywords": [
    "superset",
    "apache-superset",
    "superset-plugin",
    "superset-chart",
    "heatmap",
    "matrix",
    "echarts",
    "stratum",
    "stratum-heatmap",
    "cross-filtering"
  ],
  "author": "Francesco Castaldi",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@superset-ui/chart-controls": "*",
    "@superset-ui/core": "*",
    "echarts": ">=5.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "classnames": "^2.3.2",
    "d3-format": "^3.1.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@superset-ui/chart-controls": "^0.20.3",
    "@superset-ui/core": "^0.20.4",
    "@types/d3-format": "^3.0.4",
    "@types/lodash": "^4.14.202",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "echarts": "^5.4.3",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  }
}
